# ============================================================
# Hamu Pet 生产环境变量模板
# 用法：cp .env.production.example .env  然后填写真实值
# 注意：真实的 .env 已被 .gitignore 忽略，绝不要提交或打进镜像
# ============================================================

# --- MySQL（compose 用它初始化容器，务必改成强密码）---
MYSQL_ROOT_PASSWORD=__CHANGE_ME_TO_A_STRONG_PASSWORD__
MYSQL_DATABASE=AIChat

# --- 后端敏感配置加密密钥（至少 32 个随机字符；生成后务必长期备份，不可更换，否则已加密凭据无法读取）---
DATA_ENCRYPTION_KEY=__GENERATE_A_LONG_RANDOM_SECRET__

# --- 后端跨域白名单（同域部署可留空/填对外域名）---
CORS_ORIGINS=http://localhost:8080

# 允许管理全局上下文知识库的用户名，逗号分隔；留空表示不授权任何人
CONTEXT_ADMIN_USERNAMES=

# --- 对外访问端口 ---
WEB_PORT=8080

# --- 时区 ---
TZ=Asia/Shanghai
